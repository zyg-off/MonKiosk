{
  "name": "monkiosk",
  "productName": "MonKiosk",
  "version": "1.5.2",
  "description": "Planning, équipe, tâches, stock et ventes de ton commerce",
  "author": "zyg",
  "main": "main.js",
  "scripts": {
    "copy-web": "node copy-web.js",
    "dist": "node copy-web.js && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.zyg.monkiosk",
    "productName": "MonKiosk",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MonKiosk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MonKiosk-Installer.exe",
      "language": "1036",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "MonKiosk",
      "menuCategory": false,
      "warningsAsErrors": false
    },
    "afterPack": "./afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "zyg-off",
        "repo": "MonKiosk",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyg-off/MonKiosk.git"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}